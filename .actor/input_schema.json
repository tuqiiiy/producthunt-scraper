{
  "title": "ProductHunt Scraper Input Schema",
  "type": "object",
  "schemaVersion": 1,
  "properties": {
    "category": {
      "title": "Category",
      "type": "string",
      "description": "Select the topic/category of launches to scrape.",
      "editor": "select",
      "default": "all",
      "enum": [
        "all",
        "ai",
        "tech",
        "developer-tools",
        "productivity",
        "marketing",
        "design-tools"
      ],
      "enumTitles": [
        "All Top Launches",
        "Artificial Intelligence (AI)",
        "Technology",
        "Developer Tools",
        "Productivity",
        "Marketing",
        "Design Tools"
      ]
    },
    "maxProducts": {
      "title": "Max Products",
      "type": "integer",
      "description": "Maximum number of product launches to extract.",
      "minimum": 1,
      "maximum": 500,
      "default": 50
    },
    "proxyConfiguration": {
      "title": "Proxy Configuration",
      "type": "object",
      "description": "Optional proxy settings.",
      "editor": "proxy"
    }
  },
  "required": []
}
